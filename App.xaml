<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BatteryChecker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BatteryChecker">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Paper" Color="#0067C0" />
            <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkMuted" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="InkFaint" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="Line" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="Accent" Color="#9CDCFF" />
            <SolidColorBrush x:Key="Low" Color="#FF8A80" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
