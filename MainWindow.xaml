<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="BatteryChecker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Watt's Left">

    <Grid x:Name="Root" IsTabStop="True" Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Our own title bar: dot + name, drag anywhere on it, our own minimize and close. No maximize: the window is one size. -->
        <Grid x:Name="AppTitleBar" Height="36" Background="Transparent" Canvas.ZIndex="5" PointerPressed="TitleBar_PointerPressed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8">
                <Grid Width="12" Height="12">
                    <Ellipse Stroke="{StaticResource Ink}" StrokeThickness="3" Opacity="0.3" />
                    <Path x:Name="RingFill" Stroke="{StaticResource Ink}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <TextBlock x:Name="TitleText" Text="Watt's Left" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Spacing="2">
                <!-- Our own caption buttons: a disc that fades and springs in under the pointer, and our own glyphs. -->
                <Grid x:Name="SettingsButton" Width="28" Height="28" Background="Transparent" ToolTipService.ToolTip="Settings">
                    <Border x:Name="SettingsDisc" CornerRadius="14" Background="#33FFFFFF" />
                    <Path Data="M11.94,5.18 L11.94,6.82 L10.55,7.19 L10.05,8.38 L10.78,9.62 L9.62,10.78 L8.38,10.05 L7.19,10.55 L6.82,11.94 L5.18,11.94 L4.81,10.55 L3.62,10.05 L2.38,10.78 L1.22,9.62 L1.95,8.38 L1.45,7.19 L0.06,6.82 L0.06,5.18 L1.45,4.81 L1.95,3.62 L1.22,2.38 L2.38,1.22 L3.62,1.95 L4.81,1.45 L5.18,0.06 L6.82,0.06 L7.19,1.45 L8.38,1.95 L9.62,1.22 L10.78,2.38 L10.05,3.62 L10.55,4.81 Z M7.90,6.00 A1.9,1.9 0 1 0 4.10,6.00 A1.9,1.9 0 1 0 7.90,6.00 Z" Fill="{StaticResource Ink}" Width="12" Height="12" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="MinimizeButton" Width="28" Height="28" Background="Transparent" ToolTipService.ToolTip="Minimize">
                    <Border x:Name="MinimizeDisc" CornerRadius="14" Background="#33FFFFFF" />
                    <Path Data="M0,0.5 L10,0.5" Stroke="{StaticResource Ink}" StrokeThickness="1" Width="10" Height="1" />
                </Grid>
                <Grid x:Name="CloseButton" Width="28" Height="28" Background="Transparent" ToolTipService.ToolTip="Hide to tray">
                    <Border x:Name="CloseDisc" CornerRadius="14" Background="#C42B1C" />
                    <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{StaticResource Ink}" StrokeThickness="1" Width="10" Height="10" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Padding="28,0,28,22">

            <!-- In / Out -->
            <Grid Margin="0,18,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="InBlock" Grid.Column="0" Background="Transparent">
                    <TextBlock Text="IN" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Ink}" x:Name="InText" Text="—" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock x:Name="InSub" Text="from charger" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Line}" Margin="0,4" />

                <StackPanel x:Name="OutBlock" Grid.Column="2" Background="Transparent">
                    <TextBlock Text="OUT" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Ink}" x:Name="OutText" Text="—" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock x:Name="OutSub" Text="to laptop" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Percent -->
            <StackPanel x:Name="PercentBlock" Background="Transparent">
                <TextBlock Foreground="{StaticResource Ink}" x:Name="PercentText" Text="—" FontFamily="Segoe UI Variable Display" FontSize="68" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,-6" />
                <StackPanel x:Name="StateRow" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                    <TextBlock x:Name="StateText" Text="Reading battery…" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                    <FontIcon x:Name="Bolt" Glyph="&#xE945;" FontSize="12" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="StateRest" Text="" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="BarTrack" Height="6" CornerRadius="3" Margin="0,30,0,0" Background="{StaticResource Line}">
                    <Rectangle x:Name="BarFill" RadiusX="3" RadiusY="3" Fill="{StaticResource Accent}" HorizontalAlignment="Stretch" />
                </Border>
            </StackPanel>


            <!-- Details -->
            <Grid x:Name="TimeRow" Background="Transparent" Padding="0,6">
                <TextBlock x:Name="TimeLabel" Text="Time left" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Foreground="{StaticResource Ink}" x:Name="TimeText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
            </Grid>
            <Grid x:Name="StoredRow" Background="Transparent" Padding="0,6">
                <TextBlock Text="Stored" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Foreground="{StaticResource Ink}" x:Name="StoredText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
            </Grid>
            <Grid x:Name="VoltageRow" Background="Transparent" Padding="0,6">
                <TextBlock Text="Voltage" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Foreground="{StaticResource Ink}" x:Name="VoltageText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
            </Grid>
            <Grid x:Name="HealthRow" Background="Transparent" Padding="0,6">
                <TextBlock Text="Health" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Foreground="{StaticResource Ink}" x:Name="HealthText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Graphs: the last 30 minutes, live. Charge as an area, watts in (accent) and out (white) as lines. -->
            <StackPanel x:Name="Graphs" Visibility="Collapsed" Margin="0,12,0,6" Spacing="10">
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="CHARGE %" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                        <TextBlock x:Name="ChargeSpan" Text="0 to 100%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="52" CornerRadius="6" Background="{StaticResource Line}">
                        <Canvas x:Name="ChargeChart" Height="52" Background="Transparent">
                            <Polygon x:Name="ChargeArea" Fill="{StaticResource Ink}" Opacity="0.25" />
                            <Polyline x:Name="ChargeLine" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Rectangle x:Name="ChargeHair" Width="1" Height="52" Fill="{StaticResource Ink}" Opacity="0" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ChargeStats" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="IN" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                        <TextBlock x:Name="InScale" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="52" CornerRadius="6" Background="{StaticResource Line}">
                        <Canvas x:Name="InChart" Height="52" Background="Transparent">
                            <Polygon x:Name="InArea" Fill="{StaticResource Accent}" Opacity="0.25" />
                            <Polyline x:Name="InLine" Stroke="{StaticResource Accent}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Rectangle x:Name="InHair" Width="1" Height="52" Fill="{StaticResource Ink}" Opacity="0" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="InStats" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="OUT" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                        <TextBlock x:Name="OutScale" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="52" CornerRadius="6" Background="{StaticResource Line}">
                        <Canvas x:Name="OutChart" Height="52" Background="Transparent">
                            <Polygon x:Name="OutArea" Fill="{StaticResource Ink}" Opacity="0.25" />
                            <Polyline x:Name="OutLine" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Rectangle x:Name="OutHair" Width="1" Height="52" Fill="{StaticResource Ink}" Opacity="0" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="OutStats" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="VOLTAGE" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                        <TextBlock x:Name="VoltsScale" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Height="52" CornerRadius="6" Background="{StaticResource Line}">
                        <Canvas x:Name="VoltsChart" Height="52" Background="Transparent">
                            <Polyline x:Name="VoltsLine" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <Rectangle x:Name="VoltsHair" Width="1" Height="52" Fill="{StaticResource Ink}" Opacity="0" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="VoltsStats" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource InkMuted}" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Settings lives inside the window (not a popup) so the little guy can come and go from the toggle. -->
        <Grid x:Name="Scrim" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed" PointerPressed="Scrim_PointerPressed" />
        <Border x:Name="SettingsPanel" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,8,0" Visibility="Collapsed"
                Background="#0B57A6" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10,14,12">
            <StackPanel MinWidth="186" Spacing="8">
                <TextBlock Text="SETTINGS" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                <Grid>
                    <TextBlock Text="Party mode" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <!-- our own toggle: white pill, blue knob that slides. Also his house. -->
                    <Grid x:Name="PartyToggle" Width="40" Height="22" HorizontalAlignment="Right" Background="Transparent">
                        <Border x:Name="PartyPill" CornerRadius="11" Background="#FFFFFF" Opacity="0.55" />
                        <Ellipse x:Name="PartyKnob" Width="16" Height="16" Fill="#0067C0" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="PartyKnobSlide" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
                <Grid>
                    <TextBlock Text="Show stats" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <Grid x:Name="StatsToggle" Width="40" Height="22" HorizontalAlignment="Right" Background="Transparent">
                        <Border x:Name="StatsPill" CornerRadius="11" Background="#FFFFFF" Opacity="0.55" />
                        <Ellipse Width="16" Height="16" Fill="#0067C0" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="StatsKnobSlide" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
                <Grid>
                    <TextBlock Text="Show graphs" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <Grid x:Name="GraphsToggle" Width="40" Height="22" HorizontalAlignment="Right" Background="Transparent">
                        <Border x:Name="GraphsPill" CornerRadius="11" Background="#FFFFFF" Opacity="0.55" />
                        <Ellipse Width="16" Height="16" Fill="#0067C0" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="GraphsKnobSlide" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- The stage: a full-window layer for the little guy and his ladder. Never catches the mouse. -->
        <Canvas x:Name="Stage" Grid.RowSpan="2">
            <Path x:Name="Ladder" IsHitTestVisible="False" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9" Visibility="Collapsed" />
            <!-- The little guy: a noodle. Round head, every limb a soft curve. Each limb sits in its own body-sized canvas so it can
                 rotate about its joint on the compositor. Drawn facing right; flipped to face left. -->
            <Canvas x:Name="Dancer" Width="26" Height="28" Background="Transparent" Visibility="Collapsed" PointerPressed="Dancer_PointerPressed" PointerMoved="Dancer_PointerMoved" PointerReleased="Dancer_PointerReleased" PointerCaptureLost="Dancer_PointerReleased">
                <Ellipse Canvas.Left="10" Canvas.Top="0.5" Width="6" Height="6" Fill="{StaticResource Ink}" />
                <Path x:Name="SadMouth" Data="M11.6,5.6 Q13,4.6 14.4,5.6" Stroke="{StaticResource Paper}" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                <Ellipse x:Name="TearL" Canvas.Left="9" Canvas.Top="5" Width="2.2" Height="2.8" Fill="{StaticResource Ink}" Opacity="0" />
                <Ellipse x:Name="TearR" Canvas.Left="14.8" Canvas.Top="5" Width="2.2" Height="2.8" Fill="{StaticResource Ink}" Opacity="0" />
                <Path Data="M13,6.5 Q14.2,11.5 13,17" Stroke="{StaticResource Ink}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Canvas x:Name="ArmL" Width="26" Height="28"><Path Data="M13,9 Q10.5,13 13,18" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                <Canvas x:Name="ArmR" Width="26" Height="28"><Path Data="M13,9 Q15.5,13 13,18" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                <Canvas x:Name="LegL" Width="26" Height="28"><Path Data="M13,17 Q11,22 13,28" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
                <Canvas x:Name="LegR" Width="26" Height="28"><Path Data="M13,17 Q15,22 13,28" Stroke="{StaticResource Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
